<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WorldScience.Controls" xmlns:s="clr-namespace:WorldScience.Services" x:Class="WorldScience.LocationPicker" Width="324">
 <UserControl.Styles><StyleInclude Source="avares://WorldScience/Controls/LocationStyles.axaml"/></UserControl.Styles>
 <controls:GlassSurface KeepContentFill="True" CornerRadius="22" BorderBrush="{DynamicResource GlassEdge}" Background="{DynamicResource PopoverFill}" BorderThickness="1" ClipToBounds="True">
 <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="8,12,8,8" RowSpacing="8">
  <TextBlock Text="{x:Static s:Strings.FastestFirst}" Classes="heading" Margin="10,0"/>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="260">
   <ItemsControl x:Name="LocationList" ItemsSource="{Binding Items}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Classes="location" Classes.selected="{Binding Selected}" Click="ChooseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Detail}">
      <Grid ColumnDefinitions="25,*,Auto,14,18" ColumnSpacing="10" MinHeight="28">
       <TextBlock Text="{Binding Flag}" FontSize="19" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="12" Foreground="{DynamicResource SecondaryLabel}" VerticalAlignment="Center" FontFeatures="tnum"/>
       <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="{Binding HasSignal}">
        <Border Classes="bar" Classes.lit="{Binding Bar1}" Width="3" Height="5" VerticalAlignment="Bottom"/>
        <Border Classes="bar" Classes.lit="{Binding Bar2}" Width="3" Height="8" VerticalAlignment="Bottom"/>
        <Border Classes="bar" Classes.lit="{Binding Bar3}" Width="3" Height="11" VerticalAlignment="Bottom"/>
       </StackPanel>
       <TextBlock Grid.Column="4" Text="✓" IsVisible="{Binding Selected}" FontSize="14" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
  <Button x:Name="TestSpeedButton" Grid.Row="2" Classes="location" DataContext="{Binding Client}" Content="{Binding SpeedTestLabel}" IsEnabled="{Binding CanTestSpeed}" Click="TestSpeedClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="Test node download speeds"/>
  <TextBlock Grid.Row="3" Text="{Binding Client.SpeedTestStatus}" FontSize="11" Foreground="{DynamicResource SecondaryLabel}" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0,8,2"/>
 </Grid>
 </controls:GlassSurface>
</UserControl>
